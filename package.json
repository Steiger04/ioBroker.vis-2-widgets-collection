{
  "name": "iobroker.vis-2-widgets-collection",
  "version": "2.6.0",
  "description": "ioBroker vis-2 widget collection",
  "author": "Steiger04 <steiger04@posteo.de>",
  "contributors": [
    "Steiger04 <steiger04@posteo.de>"
  ],
  "homepage": "https://github.com/Steiger04/ioBroker.vis-2-widgets-collection",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Steiger04/ioBroker.vis-2-widgets-collection.git"
  },
  "keywords": [
    "ioBroker",
    "home automation",
    "vis-2-widgets-collection"
  ],
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.2",
    "@iobroker/vis-2-widgets-testing": "^2.0.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10"
  },
  "main": "widgets/vis-2-widgets-collection/customWidgets.js",
  "files": [
    "admin/",
    "img/",
    "widgets/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tasks",
    "copy-files": "node tasks --copy-files",
    "gen-previews": "cd src-widgets && npm run gen-previews",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "release-patch-dry": "release-script patch --dry",
    "release-minor-dry": "release-script minor --dry",
    "release-major-dry": "release-script major --dry",
    "release:sync": "node scripts/release-branches.js sync",
    "release:finish": "node scripts/release-branches.js finish",
    "test": "mocha ./test/*.test.js && cd src-widgets && npm test",
    "test:package": "mocha test/package.test.js --exit",
    "update-packages": "ncu --upgrade && cd src-widgets && ncu --upgrade && cd ..",
    "npm": "npm i && cd src-widgets && npm i",
    "lint": "eslint",
    "lintfix": "eslint . --fix",
    "format": "prettier . --check",
    "formatfix": "prettier . --write",
    "i18n:check": "node scripts/i18n-sync.js",
    "i18n:todos": "node scripts/i18n-sync.js --todos",
    "i18n:todos:dry": "node scripts/i18n-sync.js --todos --dry-run",
    "i18n:fix": "node scripts/i18n-sync.js --fix",
    "i18n:fix:dry": "node scripts/i18n-sync.js --fix --dry-run",
    "i18n:fix:verbose": "node scripts/i18n-sync.js --fix --verbose",
    "i18n:dedupe": "node scripts/i18n-sync.js --dedupe",
    "i18n:dedupe:dry": "node scripts/i18n-sync.js --dedupe --dry-run",
    "i18n:report": "node scripts/i18n-sync.js --report",
    "i18n:sync": "node scripts/i18n-sync.js --sync",
    "i18n:sync:dry": "node scripts/i18n-sync.js --sync --dry-run"
  },
  "bugs": {
    "url": "https://github.com/Steiger04/ioBroker.vis-2-widgets-collection/issues"
  },
  "readmeFilename": "README.md"
}
